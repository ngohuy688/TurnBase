      amount: 14
      cardData: {fileID: 0}
      relicData: {fileID: 0}
    - effectType: 0
      amount: 85
      cardData: {fileID: 0}
      relicData: {fileID: 0}
    nextEventData: {fileID: 0}
  - title: '[Take a Handful] Pocket a modest pouch of coins'
    description: Gain 35 Gold safely.
    effects:
    - effectType: 0
      amount: 35
      cardData: {fileID: 0}
      relicData: {fileID: 0}
    nextEventData: {fileID: 0}
  - title: '[Climb Out] Return to the surface immediately'
    description: Leave before the fumes overwhelm you.
    effects: []
    nextEventData: {fileID: 0}
